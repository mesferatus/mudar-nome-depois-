{
  "name": "kairotec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.14.0",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "main": "electron/main.cjs",
  "description": "Kairotec — planner pessoal",
  "author": "Kairotec",
  "build": {
    "appId": "com.kairotec.app",
    "productName": "Kairotec",
    "copyright": "Kairotec",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "Kairotec-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kairotec",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mesferatus",
        "repo": "mudar-nome-depois-",
        "releaseType": "release"
      }
    ]
  }
}
